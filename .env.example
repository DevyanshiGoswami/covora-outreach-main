# Use the dedicated outbound database/auth project, never the content portal project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME=Covora Outreach

# Server-only dedicated outbound API origin (HTTPS in production, no path).
# Switch this together with the matching public database URL/key at cutover.
OUTBOUND_API_ORIGIN=
